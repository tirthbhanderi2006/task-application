# Server Configuration
PORT=5000

# Secret key for JWT signing (Practical 7 Auth)
JWT_SECRET=your_jwt_secret_here

# Frontend API URL
VITE_API_URL=http://localhost:5000

# Database Provider Selection ('mongo' or 'firebase')
DB_TYPE=mongo

# MongoDB Connection URI
MONGO_URI=mongodb://127.0.0.1:27017/task-manager

# Firebase Configuration (Optional)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id

# ---------------------------------------------------------------------------
# Docker Compose configuration
# Copy this file to `.env` (`.env` is git-ignored) and adjust as needed.
# Compose reads these variables for interpolation when the stack starts.
# ---------------------------------------------------------------------------

# Host port the containerised frontend (nginx) is published on
FRONTEND_PORT=8080

# Host port the containerised backend API is published on
BACKEND_PORT=5000

# JWT signing secret for the containerised backend.
# ALWAYS override this with a long random value outside of local development.
JWT_SECRET=change_me_in_production_use_a_long_random_secret
